# Documentation template. The Worker does not auto-load dotenv.
# Configure secrets in your hosting provider's native secret store.
SITE_ORIGIN=https://bridge.example.invalid
SITE_OWNER_ID=REPLACE_WITH_VERIFIED_PLATFORM_OWNER_ID
EXPECTED_BOT_USERNAME=example_agent_bot
BRIDGE_MASTER_KEY=REPLACE_WITH_32_RANDOM_BYTES_STANDARD_BASE64
# Optional webhook mode; same secrets must be provisioned at ingress.
TELEGRAM_WEBHOOK_URL=https://ingress.example.invalid/telegram-webhook
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_URLSAFE_SECRET_AT_LEAST_32_CHARS
PRIVATE_INGEST_SECRET=REPLACE_WITH_SHARED_RANDOM_SECRET_AT_LEAST_32_CHARS
# Bot token is entered via the authenticated private /setup page, not this file.
